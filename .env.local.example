# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/openbrief?sslmode=require

# ─── Payload CMS ─────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
PAYLOAD_SECRET=change-this-to-a-long-random-secret-min-32-chars

# ─── Image Storage (Vercel Blob) ─────────────────────────────────────────────
# Automatically provided by Vercel when you add Blob Storage from Storage tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://theopenbrief.app
# For local dev:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
